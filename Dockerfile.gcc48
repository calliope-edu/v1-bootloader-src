# Period toolchain for the nRF51 SDK-8 / S110 bootloader — matches the factory
# build (gcc-arm-none-eabi 4.8.x, no LTO). Modern gcc 10 + -flto produces a
# bootloader that runs but never starts BLE advertising; 4.8 fits the flash
# region without LTO, like the factory image.
FROM ubuntu:20.04
ENV DEBIAN_FRONTEND=noninteractive
RUN dpkg --add-architecture i386 && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
      wget ca-certificates bzip2 make \
      libc6:i386 libstdc++6:i386 libncurses5:i386 zlib1g:i386 && \
    rm -rf /var/lib/apt/lists/*
RUN wget -q "https://launchpad.net/gcc-arm-embedded/4.8/4.8-2014-q3-update/+download/gcc-arm-none-eabi-4_8-2014q3-20140805-linux.tar.bz2" -O /tmp/gcc.tar.bz2 && \
    mkdir -p /opt && tar -xjf /tmp/gcc.tar.bz2 -C /opt && rm /tmp/gcc.tar.bz2
ENV PATH="/opt/gcc-arm-none-eabi-4_8-2014q3/bin:${PATH}"
WORKDIR /src
